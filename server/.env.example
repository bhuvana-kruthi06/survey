# SurveyFlow Backend Environment Configuration Example
# Copy this file to .env and configure your variables

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/survey

# Port for Express server
PORT=5000

# Secret key for signing and verifying JWT tokens
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Optional initial administrator seed credentials
ADMIN_EMAIL=admin@surveyflow.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator
